# Copy to `.env` if your shell, container or process manager loads one. GhostAI
# itself does not parse a dotenv file — it reads the environment it is given.
#
# Every variable here is optional and every value below is the default, so a
# `.env` that is an exact copy of this file changes nothing.
#
# API keys belong in the encrypted vault, not here. Add a provider in
# Settings → Providers (or `ghostai init`) and the key goes to `vault.json`,
# AES-256-GCM, with its master key in the OS keychain. The ones at the bottom
# are the documented fallback for a container or CI job that cannot reach a
# keychain — read only when the vault has no entry for that provider instance,
# because the vault wins.
#
# See docs/configuration.md#environment-variables.

# --- Where everything lives ---------------------------------------------------

# config.json, ghost.db, the vault and the workspace all live under this.
# Beaten by `--home`.
#
# Do not leave this set-but-empty. An empty value is not the same as an unset
# one: it resolves to the *current working directory*, and GhostAI would
# scatter its database and workspace into wherever you happened to run it.
# Comment the line out or give it a path.
GHOSTAI_HOME=~/.ghostai

# --- The login, for a first boot nobody can attend ---------------------------

# `ghostai serve` prints a one-time setup code when no password is set, and the
# browser wizard spends it. These are how you skip that on a machine with no
# terminal to read the code from — in a container, or under systemd.
#
# Empty means "not set" for both, so leaving them blank is safe. A username
# without a password is refused rather than half-applied.
GHOSTAI_PASSWORD=
GHOSTAI_USERNAME=

# --- Output -------------------------------------------------------------------

# Ranks above `config.ui.locale`, which ranks above `LANG`.
# English is the only locale that currently ships.
GHOSTAI_LANG=en

# trace | debug | info | warn | error | fatal.
# Falls back to LOG_LEVEL, then `info`. An unrecognised value falls back too,
# rather than taking the process down at boot. Note `ghostai chat` overrides this
# to `error` unless you pass `--verbose`, so the answer is not buried in logs.
GHOSTAI_LOG_LEVEL=info

# Any non-empty value prints stack traces instead of the one-line operator
# message. `GHOSTAI_DEBUG=1` to turn it on.
GHOSTAI_DEBUG=

# --- Provider keys, if you are not using the vault ---------------------------

# Empty is treated as absent, so the blanks below enable nothing.
#
# Ollama, LM Studio and llama.cpp need no key at all — they are the reason this
# whole section can stay empty.
#
# `anthropic` is in the registry but this build ships no adapter for the
# `anthropic-messages` wire, so an instance of it is refused at construction.
# The key is listed for completeness, not because it can be used today.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
VLLM_API_KEY=
