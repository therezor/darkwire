# Copy to `.env` if your shell, container or process manager loads one. DarkWire
# itself does not parse a dotenv file — it reads the environment it is given.
#
# Every variable here is optional and every value below is the default, so a
# `.env` that is an exact copy of this file changes nothing.
#
# API keys belong in the encrypted vault, not here. Add a provider in
# Settings → Providers (or `darkwire init`) and the key goes to `vault.json`,
# AES-256-GCM, with its master key in the OS keychain. The ones at the bottom
# are the documented fallback for a container or CI job that cannot reach a
# keychain — read only when the vault has no entry for that provider instance,
# because the vault wins.
#
# See docs/configuration.md#environment-variables.

# --- Where everything lives ---------------------------------------------------

# config.yaml, darkwire.db, the vault and the logs live under this. Your own
# files do not: they are under DARKWIRE_WORKSPACES below. Beaten by `--home`.
#
# Do not leave this set-but-empty. An empty value is not the same as an unset
# one: it resolves to the *current working directory*, and DarkWire would
# scatter its database into wherever you happened to run it. Comment the line
# out or give it a path.
DARKWIRE_HOME=~/.darkwire

# The folder the workspaces live in, one directory per workspace including the
# default. Beaten by `--workspaces`, and it beats the config file's
# `workspaces` key.
#
# An empty value here is simply unset, unlike DARKWIRE_HOME above: it falls
# back to ~/DarkWire/workspaces rather than to the working directory.
DARKWIRE_WORKSPACES=~/DarkWire/workspaces

# --- The login, for a first boot nobody can attend ---------------------------

# `darkwire serve` prints a one-time setup code when no password is set, and the
# browser wizard spends it. These are how you skip that on a machine with no
# terminal to read the code from — in a container, or under systemd.
#
# Empty means "not set" for both, so leaving them blank is safe. A username
# without a password is refused rather than half-applied.
DARKWIRE_PASSWORD=
DARKWIRE_USERNAME=

# --- Output -------------------------------------------------------------------

# Ranks above `config.ui.locale`, which ranks above `LANG`.
# English is the only locale that currently ships.
DARKWIRE_LANG=en

# trace | debug | info | warn | error | fatal.
# Falls back to LOG_LEVEL, then `info`. An unrecognised value falls back too,
# rather than taking the process down at boot. Note `darkwire chat` overrides this
# to `error` unless you pass `--verbose`, so the answer is not buried in logs.
DARKWIRE_LOG_LEVEL=info

# Any non-empty value prints stack traces instead of the one-line operator
# message. `DARKWIRE_DEBUG=1` to turn it on.
DARKWIRE_DEBUG=

# --- Containers, for an agent whose commands run in one -----------------------

# A single-binary install needs none of these. `darkwire serve` starts its own
# sandbox service on a socket under DARKWIRE_HOME and talks to that; the ones
# below are for a deployment where the service runs separately, which is what
# `deploy/sandbox/compose.yaml` does.

# Point `serve` at a service somebody else runs. Naming one stops it starting
# its own, so a path that does not answer means no container runs at all.
DARKWIRE_SANDBOX_SOCKET=

# `docker` or `podman`. Podman is wire-compatible for everything used here.
DARKWIRE_CONTAINER_ENGINE=docker

# Only read by `darkwire-environment serve-env`, the standalone service.
#
# DARKWIRE_DATA_DIR is the absolute path the *daemon* sees, which is not the
# path the service sees when it is itself in a container. DARKWIRE_ENVIRONMENTS
# is the comma-separated allow-list of definitions it registers.
DARKWIRE_DATA_DIR=
DARKWIRE_ENVIRONMENTS=dev

# The egress gateway image, and the only one of these an ordinary install may
# need: an agent asking for `allowlist` egress has nothing to enforce it without
# one. Build it with deploy/sandbox/Dockerfile.gateway.
DARKWIRE_GATEWAY_IMAGE=

# --- Provider keys, if you are not using the vault ---------------------------

# Empty is treated as absent, so the blanks below enable nothing.
#
# Ollama, LM Studio and llama.cpp need no key at all — they are the reason this
# whole section can stay empty.
#
# `anthropic` is in the registry but this build ships no adapter for the
# `anthropic-messages` wire, so an instance of it is refused at construction.
# The key is listed for completeness, not because it can be used today.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
VLLM_API_KEY=
