{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "definition": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "permission": {
      "default": "ask",
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    }
  },
  "required": [
    "name",
    "definition"
  ],
  "additionalProperties": false
}
