{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "tool.approvalRequest"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "turnId": {
      "type": "string",
      "minLength": 1
    },
    "callId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "args": {},
