{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "definition": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "ghostai.environment/1"
        },
        "kind": {
          "default": "container",
          "type": "string",
          "enum": [
            "container"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "prompt": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "shared": {
          "type": "boolean"
        },
        "runtime": {
          "default": "runc",
          "type": "string",
          "enum": [
            "runc",
            "runsc",
            "kata"
          ]
        },
        "workdir": {
          "default": "/workspace",
          "type": "string"
        },
        "user": {
          "default": "1000:1000",
          "type": "string"
        },
        "caps": {
          "default": {},
          "type": "object",
          "properties": {
            "drop": {
              "default": [
                "ALL"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "add": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "security": {
          "default": {},
          "type": "object",
          "properties": {
            "noNewPrivileges": {
              "default": true,
              "type": "boolean"
            },
            "seccomp": {
              "default": "default",
              "type": "string",
              "enum": [
                "default",
                "unconfined"
              ]
            },
            "readOnlyRoot": {
              "default": true,
              "type": "boolean"
            },
            "tmpfs": {
              "default": [
                "/tmp:rw,nosuid,size=64m"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "devices": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "limits": {
          "default": {},
          "type": "object",
          "properties": {
            "memoryMb": {
              "default": 512,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cpus": {
              "default": 1,
              "type": "number",
              "minimum": 0
            },
            "pidsMax": {
              "default": 256,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "shmSizeMb": {
              "default": 64,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "env": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "name",
        "image"
      ],
      "additionalProperties": false
    },
    "weakened": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gatewayProblem": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "weakened"
  ]
}
