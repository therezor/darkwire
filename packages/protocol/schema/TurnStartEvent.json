{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "turn.start"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessionKey": {
      "type": "string",
      "minLength": 1
    },
    "turnId": {
      "type": "string",
      "minLength": 1
    },
    "firstSeq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "agentId": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "posted": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "from": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exec",
                "automation"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "error",
                "killed",
                "timeout"
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "label",
            "status"
          ]
        }
      },
      "required": [
        "text",
        "from"
      ]
    }
  },
  "required": [
    "type",
    "seq",
    "sessionKey",
    "turnId",
    "agentId",
    "model",
    "provider"
  ]
}
