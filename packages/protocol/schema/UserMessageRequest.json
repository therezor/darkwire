{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "user.message"
    },
    "sessionKey": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "attachments": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "mimeType",
          "path"
        ]
      }
    },
    "agentId": {
      "type": "string"
    },
    "clientMessageId": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "sessionKey",
    "content"
  ]
}
