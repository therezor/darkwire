{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "tool.approve"
    },
    "callId": {
      "type": "string",
      "minLength": 1
    },
    "approved": {
      "type": "boolean"
    },
    "scope": {
      "default": "once",
      "type": "string",
      "enum": [
        "once",
        "session"
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "argv": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "action",
        "argv"
      ]
    }
  },
  "required": [
    "type",
    "callId",
    "approved"
  ]
}
