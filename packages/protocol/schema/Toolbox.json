{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ghostai.toolbox/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "default": "0.0.0",
      "type": "string"
    },
    "label": {
      "default": "",
      "type": "string"
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "default": "",
            "type": "string"
          },
          "args": {
            "default": "",
            "type": "string"
          },
          "example": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiresArgs": {
            "default": false,
            "type": "boolean"
          },
          "permission": {
            "default": "ask",
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "notes": {
      "default": "",
      "type": "string"
    },
    "expose": {
      "default": "prompt",
      "type": "string",
      "enum": [
        "prompt",
        "tools"
      ]
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "default": "runc",
      "type": "string",
      "enum": [
        "runc",
        "runsc",
        "kata"
      ]
    },
    "workdir": {
      "default": "/workspace",
      "type": "string"
    },
    "user": {
      "default": "",
      "type": "string"
    },
    "caps": {
      "default": {},
      "type": "object",
      "properties": {
        "drop": {
          "default": [
            "ALL"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "add": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "security": {
      "default": {},
      "type": "object",
      "properties": {
        "noNewPrivileges": {
          "default": true,
          "type": "boolean"
        },
        "seccomp": {
          "default": "default",
          "type": "string",
          "enum": [
            "default",
            "unconfined"
          ]
        },
        "readOnlyRoot": {
          "default": true,
          "type": "boolean"
        },
        "tmpfs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "devices": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "memoryMb": {
          "default": 2048,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cpus": {
          "default": 2,
          "type": "number",
          "minimum": 0
        },
        "pidsMax": {
          "default": 512,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "shmSizeMb": {
          "default": 256,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "network": {
      "default": {},
      "type": "object",
      "properties": {
        "maxMode": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "allowlist",
            "open"
          ]
        },
        "dns": {
          "default": [
            "127.0.0.11"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proxyAllowHosts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "env": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "name",
    "image"
  ]
}
