{
  "type": "object",
  "properties": {
    "model": {
      "default": "",
      "type": "string"
    },
    "provider": {
      "default": "auto",
      "type": "string",
      "minLength": 1
    },
    "maxTokens": {
      "default": 8192,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "contextWindowTokens": {
      "default": 65536,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "maxToolIterations": {
      "default": 40,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "toolTimeoutMs": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "loopWallTimeoutMs": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subagentTimeoutMs": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reasoningEffort": {
      "type": "string",
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "visionEnabled": {
      "default": true,
      "type": "boolean"
    },
    "toolsEnabled": {
      "default": true,
      "type": "boolean"
    },
    "exec": {
      "default": {},
      "type": "object",
      "properties": {
        "timeoutMs": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pathAppend": {
          "default": "",
          "type": "string"
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              },
              "argv": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "action",
              "argv"
            ]
          }
        },
        "shell": {
          "default": "ask",
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "envAllowlist": {
          "default": [
            "PATH",
            "HOME",
            "LANG",
            "TZ"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxOutputBytes": {
          "default": 1048576,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "approvalTimeoutMs": {
      "default": 300000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxOutputChars": {
      "default": 8192,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "lazyDiscovery": {
      "default": false,
      "type": "boolean"
    },
    "pinnedTools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
