{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ghostai.agent-preset/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "label": {
      "default": "",
      "type": "string"
    },
    "systemPrompt": {
      "default": "",
      "type": "string"
    },
    "livePrompt": {
      "default": "",
      "type": "string"
    },
    "wrapUpPrompt": {
      "default": "",
      "type": "string"
    },
    "platformPrompt": {
      "default": "",
      "type": "string"
    },
    "toolPolicyPrompt": {
      "default": "",
      "type": "string"
    },
    "memoryPrompt": {
      "default": "",
      "type": "string"
    },
    "skillsPrompt": {
      "default": "",
      "type": "string"
    },
    "promptMode": {
      "default": "template",
      "type": "string",
      "enum": [
        "template",
        "raw"
      ]
    },
    "toolsEnabled": {
      "type": "boolean"
    },
    "tools": {
      "default": {
        "read_file": "allow",
        "list_dir": "allow",
        "write_file": "allow",
        "edit_file": "allow",
        "exec": "ask",
        "memory": "allow",
        "skill": "allow"
      },
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "allow",
          "ask",
          "deny"
        ]
      }
    },
    "environment": {
      "default": {},
      "type": "object",
      "properties": {
        "name": {
          "default": "",
          "type": "string"
        },
        "network": {
          "default": {},
          "type": "object",
          "properties": {
            "mode": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "allowlist",
                "open"
              ]
            },
            "allow": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hosts": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dns": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "alwaysUseOwn": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "subagents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "default": "",
            "type": "string"
          },
          "permission": {
            "default": "allow",
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "skills": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"
      }
    }
  },
  "required": [
    "schema",
    "id"
  ]
}
