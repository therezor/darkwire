        "name": "😀 Agent 😀 One 𝔗𝔴𝔬",
        "reserved": [],
        "fallback": "x"
      },
      "output": "agent-one"
    },
    {
      "name": "CRLF is a separator",
      "input": {
        "name": "one\r\ntwo",
        "reserved": [],
        "fallback": "x"
      },
      "output": "one-two"
    }
  ]
