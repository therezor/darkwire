      },
      "output": "n-c-d"
    },
    {
      "name": "falls back when nothing usable is left",
      "input": {
        "name": "///",
        "reserved": [],
        "fallback": "thing"
      },
      "output": "thing"
    },
    {
      "name": "falls back on empty",
      "input": {
        "name": "",
        "reserved": [],
        "fallback": "thing"
      },
      "output": "thing"
    },
    {
      "name": "falls back on a reserved result",
      "input": {
        "name": "Nul",
        "reserved": [
          "nul"
        ],
        "fallback": "thing"
      },
      "output": "thing"
    },
    {
      "name": "truncates to forty characters and trims a trailing hyphen",
      "input": {
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-b",
        "reserved": [],
        "fallback": "x"
      },
      "output": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "name": "truncates a long name",
      "input": {
        "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "reserved": [],
        "fallback": "x"
      },
      "output": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "name": "astral-plane characters are separators",
