{
  "description": "CredentialVault envelopes. `input.entries` are applied with set() in order, then `input.deletes` with delete(); `output.file` is the exact text of vault.json after the last write and `output.plaintext` is what its `data` decrypts to. AES-256-GCM with a 12-byte IV and a 16-byte tag stored separately from the ciphertext; the AAD is the UTF-8 bytes of `constants.aad`. The plaintext is JSON.stringify of namespace -> key -> value with no whitespace, in insertion order. `keyFile` is what keyFileStore().save() writes for the same key. The constructor never writes; an empty map on disk only comes from deleting the last key.",
  "constants": {
    "aad": "ghostai-vault-v1",
    "version": 1,
    "algorithm": "aes-256-gcm",
    "keyBytes": 32,
    "ivBytes": 12,
    "tagBytes": 16
  },
  "keyFile": {
    "input": {
      "key": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA="
    },
    "output": {
      "contents": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA="
    }
  },
  "cases": [
    {
      "name": "one namespace, one key",
      "input": {
        "key": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "iv": "AQIDBAUGBwgJCgsM",
        "entries": [
          {
            "namespace": "openai",
            "key": "apiKey",
            "value": "sk-test-123"
          }
        ],
        "deletes": []
      },
      "output": {
        "file": "{\"v\":1,\"alg\":\"aes-256-gcm\",\"iv\":\"AQIDBAUGBwgJCgsM\",\"tag\":\"YhWHCd3Yf4sABqnoEDo75w==\",\"data\":\"1QzD7VUFQoRNh4MHgopUbmwn0B10BrofIXIGPzuRTo+nykQ=\"}",
        "plaintext": "{\"openai\":{\"apiKey\":\"sk-test-123\"}}"
      }
    },
    {
      "name": "two namespaces, several keys, in insertion order",
      "input": {
        "key": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "iv": "AQIDBAUGBwgJCgsM",
        "entries": [
          {
            "namespace": "openai",
            "key": "apiKey",
            "value": "sk-1"
          },
          {
            "namespace": "telegram",
            "key": "botToken",
            "value": "123456:abc-DEF"
          },
          {
            "namespace": "openai",
            "key": "orgId",
            "value": "org-9"
          }
        ],
        "deletes": []
      },
      "output": {
        "file": "{\"v\":1,\"alg\":\"aes-256-gcm\",\"iv\":\"AQIDBAUGBwgJCgsM\",\"tag\":\"AtOgS9qZzgoYvpDScMJx7A==\",\"data\":\"1QzD7VUFQoRNh4MHgopUbmwn0B10BrofZDVZaXnSG/XhlQOVoq/3MaRG+y8GeAOPvGThisfvrcl/g0oDfdvWL5iGStyi8LafazpdDhtlnR6tH0J79g==\"}",
        "plaintext": "{\"openai\":{\"apiKey\":\"sk-1\",\"orgId\":\"org-9\"},\"telegram\":{\"botToken\":\"123456:abc-DEF\"}}"
      }
    },
    {
      "name": "an empty map, after the last key is deleted",
      "input": {
        "key": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "iv": "AQIDBAUGBwgJCgsM",
        "entries": [
          {
            "namespace": "openai",
            "key": "apiKey",
            "value": "sk-1"
          }
        ],
        "deletes": [
          {
            "namespace": "openai",
            "key": "apiKey"
          }
        ]
      },
      "output": {
        "file": "{\"v\":1,\"alg\":\"aes-256-gcm\",\"iv\":\"AQIDBAUGBwgJCgsM\",\"tag\":\"z1I/4lvhuSGxlI12s6vxXA==\",\"data\":\"1VM=\"}",
        "plaintext": "{}"
      }
    },
    {
      "name": "a namespace named __proto__",
      "input": {
        "key": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "iv": "AQIDBAUGBwgJCgsM",
        "entries": [
          {
            "namespace": "__proto__",
            "key": "polluted",
            "value": "no"
          }
        ],
        "deletes": []
      },
      "output": {
        "file": "{\"v\":1,\"alg\":\"aes-256-gcm\",\"iv\":\"AQIDBAUGBwgJCgsM\",\"tag\":\"B+99/iwP97EGZgkDxNFPCg==\",\"data\":\"1QzzwkAZTJkA4qcH2YEfVWYynlIiELUQbzUbJDTdAQ==\"}",
        "plaintext": "{\"__proto__\":{\"polluted\":\"no\"}}"
      }
    },
    {
      "name": "a value with unicode, quotes and a newline",
      "input": {
        "key": "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=",
        "iv": "AQIDBAUGBwgJCgsM",
        "entries": [
          {
            "namespace": "mcp:github",
            "key": "token",
            "value": "tökén\n\"quoted\" 🐕"
          }
        ],
        "deletes": []
      },
      "output": {
        "file": "{\"v\":1,\"alg\":\"aes-256-gcm\",\"iv\":\"AQIDBAUGBwgJCgsM\",\"tag\":\"mjBGXtUT4U2YC7nnlgulYA==\",\"data\":\"1QzB/kBRRIQb1Y1HwcBGB30xmUI4V+sQIdTDINUJEuDr6xvGuLLkefk4pCPUk/Z2+37u\"}",
        "plaintext": "{\"mcp:github\":{\"token\":\"tökén\\n\\\"quoted\\\" 🐕\"}}"
      }
    }
  ]
}
