{
  "description": "guardExec(argv, {jail, config, env, sandboxed}). `input.config` is a patch over ExecToolConfigSchema's defaults ({} means the defaults), `input.env` is the whole process environment the guard sees. `output` is {plan: {file, args, cwd, env, timeoutMs, maxOutputBytes}} or {error: {kind, message}}. The workspace root is a temp directory holding `layout`; it is spelled `<root>` and its parent `<base>` wherever either appears in a plan or a message. `escape` is a symlink to `<base>` and `notes.txt` a symlink to `<base>/outside.txt`; `<base>/outside.txt` exists.",
  "layout": {
    "files": [
      "script.js",
      "build.sh",
      "src/a.ts"
    ],
    "directories": [
      "src"
    ],
    "symlinks": {
      "escape": "<base>",
      "notes.txt": "<base>/outside.txt"
    },
    "outside": [
      "<base>/outside.txt"
    ]
  },
  "cases": [
    {
      "name": "argv unchanged, rooted at the workspace",
      "input": {
        "argv": [
          "node",
          "script.js",
          "--flag"
        ],
        "config": {},
        "env": {
          "PATH": "/usr/bin:/bin",
          "HOME": "/home/ghost",
          "LANG": "en_US.UTF-8",
          "AWS_SECRET_ACCESS_KEY": "leak"
        },
        "sandboxed": false
      },
      "output": {
        "plan": {
          "file": "node",
          "args": [
            "script.js",
            "--flag"
          ],
          "cwd": "<root>",
          "env": {
            "PATH": "/usr/bin:/bin",
            "HOME": "/home/ghost",
            "LANG": "en_US.UTF-8"
          },
          "timeoutMs": 0,
          "maxOutputBytes": 1048576
        }
      }
    },
